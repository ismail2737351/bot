# Discord Bot Token
TOKEN=your_discord_bot_token

# Discord Application
CLIENT_ID=your_client_id
GUILD_ID=your_guild_id

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Redis (Optional)
REDIS_URL=redis://localhost:6379

# Bot Settings
PREFIX=!
NODE_ENV=development

# Logging
LOG_LEVEL=info
